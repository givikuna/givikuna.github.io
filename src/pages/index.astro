---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ProjectItem } from "../types/ProjectItem";
import { renderCompactProjectMarkdown } from "../utils/projects";
import { sortPostsByDate, type BlogPostModule } from "../utils/blog";
import { project_items } from "../data/projects";

const featuredProjects: ReadonlyArray<ProjectItem> = project_items.slice(0, 2);

const postImports: Record<string, BlogPostModule> = import.meta.glob<BlogPostModule>(
    "./blog/*.md",
    { eager: true },
);
const latestPosts: ReadonlyArray<BlogPostModule> = sortPostsByDate(
    Object.values(postImports),
).slice(0, 3);
---

<BaseLayout title="Home">
    <div class="home-grid">
        <div class="home-col">
            <section class="home-section">
                <h2>about me</h2>
                <p>hello. welcome to my website. my name is givi.</p>
                <p>I'm a student at <a href="https://www.rutgers.edu/">rutgers</a>.</p>
                <p>
                    I major in <a href="https://math.rutgers.edu/">math</a> and
                    <a href="https://www.cs.rutgers.edu/">cs</a>. and minor in
                    <a href="https://physics.rutgers.edu/">physics</a>
                </p>
            </section>

            <section class="home-section">
                <h2>latest blog posts</h2>
                {
                    latestPosts.length === 0 ? (
                        <p>no blog posts yet.</p>
                    ) : (
                        <ul style="list-style: none; padding: 0;">
                            {latestPosts.map((post: BlogPostModule) => (
                                <li style="margin-bottom: 1rem;">
                                    <a
                                        href={post.url}
                                        style="font-weight: bold;"
                                    >
                                        {post.frontmatter.title}
                                    </a>
                                    <span style="color: var(--bg3); font-size: 0.9rem;">
                                        {" "}
                                        &mdash; {post.frontmatter.pubDate}
                                    </span>
                                    <p style="margin: 0.2rem 0 0 0; color: var(--fg4); font-size: 0.95rem;">
                                        {post.frontmatter.description}
                                    </p>
                                </li>
                            ))}
                        </ul>
                    )
                }
                <p style="margin-top: 1rem;">
                    <a href="/blog/">all posts &rarr;</a> &bull; <a href="/rss.xml">rss feed</a>
                </p>
            </section>

            <section class="tools-section home-section">
                <h2>tools & languages</h2>
                <p style="color: var(--fg4); font-size: 0.9rem; margin-bottom: 1.5rem;">
                    languages and tools that I am highly proficient in:
                </p>
                <ul class="tools-list">
                    <li>
                        <img
                            src="/icons/python.png"
                            alt="Python"
                            loading="lazy"
                        />
                        <span>Python</span>
                    </li>
                    <li>
                        <img
                            src="/icons/ts.png"
                            alt="TypeScript"
                            loading="lazy"
                        />
                        <span>TypeScript</span>
                    </li>
                    <li>
                        <img
                            src="/icons/astro.png"
                            alt="Astro"
                            loading="lazy"
                        />
                        <span>Astro</span>
                    </li>
                    <li>
                        <img
                            src="/icons/nix.png"
                            alt="Nix"
                            loading="lazy"
                        />
                        <span>Nix</span>
                    </li>
                    <li>
                        <img
                            src="/icons/rkt.png"
                            alt="Racket"
                            loading="lazy"
                        />
                        <span>Racket</span>
                    </li>
                    <li>
                        <img
                            src="/icons/rust.png"
                            alt="Rust"
                            loading="lazy"
                        />
                        <span>Rust</span>
                    </li>
                    <li>
                        <img
                            src="/icons/html.png"
                            alt="HTML"
                            loading="lazy"
                        />
                        <span>HTML / CSS</span>
                    </li>
                </ul>
            </section>
        </div>

        <div class="home-col">
            <section class="home-section">
                <h2>featured projects</h2>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    {
                        featuredProjects.map((project: ProjectItem) => (
                            <Fragment set:html={renderCompactProjectMarkdown(project)} />
                        ))
                    }
                </div>
                <p style="margin-top: 1rem;"><a href="/projects/">view all projects &rarr;</a></p>
            </section>

            <section class="home-section">
                <h2>sitemap</h2>
                <ul>
                    <li><a href="/">/home</a> &mdash; overview</li>
                    <li><a href="/projects/">/projects</a> &mdash; all projects</li>
                    <li><a href="/cv/">/cv</a> &mdash; curriculum vitae</li>
                    <li><a href="/social/">/social</a> &mdash; social media</li>
                    <li><a href="/git/">/git</a> &mdash; git forges</li>
                    <li><a href="/open-source/">/open-source</a> &mdash; open source</li>
                    <li><a href="/blog/">/blog</a> &mdash; articles/blog posts</li>
                    <li><a href="/uses/">/uses</a> &mdash; personal workflows</li>
                    <li><a href="/interests/">/interests</a> &mdash; reading list</li>
                </ul>
            </section>
        </div>
    </div>
</BaseLayout>
