---
import BaseLayout from "../layouts/BaseLayout.astro";

import { SocialItem } from "../types/SocialItem";

import { social_items } from "../data/social";
---

<BaseLayout title="Social">
    <h1>socials:</h1>
    <p>where to find me:</p>

    <ul class="social-list">
        {
            social_items.map((item: SocialItem) => (
                <li>
                    <a
                        href={item.url}
                        class="social-card"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <img
                            src={`/icons/${item.icon}`}
                            alt={item.platform}
                            width="30"
                            height="30"
                        />
                        <div>
                            <strong style="color: var(--yellow); display: block;">
                                {item.platform}
                            </strong>
                            <span style="color: var(--fg4); font-size: 0.9rem;">{item.handle}</span>
                        </div>
                    </a>
                </li>
            ))
        }
    </ul>
</BaseLayout>
