---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SocialItem } from "../types/SocialItem";
import { social_items } from "../data/social";
---

<BaseLayout title="Social">
    <h1>socials</h1>
    <p>where to find me across the web:</p>

    <div class="social-grid">
        {
            social_items.map((item: SocialItem) => (
                <a
                    href={item.url}
                    class="social-square"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <img
                        src={`/icons/${item.icon}`}
                        alt={item.platform}
                        loading="lazy"
                    />
                    <div class="social-text">
                        <span class="platform-name">{item.platform}</span>
                        <span class="platform-handle">{item.handle}</span>
                    </div>
                </a>
            ))
        }
    </div>
</BaseLayout>
