---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { sortPostsByDate, type BlogPostModule } from "../../utils/blog";

const postImports: Record<string, BlogPostModule> = import.meta.glob<BlogPostModule>("./*.md", {
    eager: true,
});

const posts: ReadonlyArray<BlogPostModule> = sortPostsByDate(Object.values(postImports));
---

<BaseLayout title="Blog">
    <h1>Blog</h1>
    <p>
        personal blog about everything and anything. subscribe via{" "}
        <a href="/rss.xml">RSS</a>.
    </p>

    <hr />

    {
        posts.length === 0 ? (
            <p>No posts published yet.</p>
        ) : (
            <ul>
                {posts.map((post: BlogPostModule) => (
                    <li style="margin-bottom: 1.25rem;">
                        <a
                            href={post.url}
                            style="font-size: 1.15rem; font-weight: bold;"
                        >
                            {post.frontmatter.title}
                        </a>
                        <span style="color: var(--fg4);"> &mdash; {post.frontmatter.pubDate}</span>
                        <p style="margin: 0.25rem 0 0 0; color: var(--fg2);">
                            {post.frontmatter.description}
                        </p>
                    </li>
                ))}
            </ul>
        )
    }
</BaseLayout>
